#!/bin/bash
# N=17 central-field scan for the Born-like second-neighbor WD ring.
# One array element owns one hz0 value and checkpoints after every momentum.
#PBS -N wd2_hz0_N17
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=16:mem=256gb
#PBS -l walltime=120:00:00
#PBS -J 0-19
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/scripts/run_three_ring_activation_resolved.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../scripts/run_three_ring_activation_resolved.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate the activation-resolved runner. Submit from repository root or hpc/." >&2
  exit 2
fi
cd "$REPO_ROOT"

if [[ -n "${ZEUS_ENV_SETUP:-}" ]]; then source "$ZEUS_ENV_SETUP"; fi
if [[ -n "${VIRTUAL_ENV_PATH:-}" ]]; then source "$VIRTUAL_ENV_PATH/bin/activate"; fi

: "${RUN_ROOT:?submit through hpc/submit_zeus_ring_second_neighbor_wd_hz0_scan_N17.sh}"
ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:?PBS array index unavailable}}"
CONFIG="${CONFIG:-configs/ring_second_neighbor_wd_hz0_scan_N17.json}"
PYTHON_BIN="${PYTHON_BIN:-python3.11}"
mkdir -p "$RUN_ROOT/logs" "$RUN_ROOT/.mplconfig/task_$ARRAY_INDEX"
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig/task_$ARRAY_INDEX"
export PYTHONUNBUFFERED=1
export PYTHONWARNINGS="${PYTHONWARNINGS:-ignore:.*font family.*not found.*,ignore:.*Glyph.*missing from font.*}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-16}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-16}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-16}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-16}"

SCAN_LINE="$($PYTHON_BIN -c 'import json,sys; c=json.load(open(sys.argv[1])); x=c["cases"][int(sys.argv[2])]; print("hz0={:.17g} hz0_over_hz={:.8g}".format(x["parameter_overrides"]["hz0"], x["hz0_over_hz"]))' "$CONFIG" "$ARRAY_INDEX")"
LOG="$RUN_ROOT/logs/task_${ARRAY_INDEX}.log"
echo "[$(date --iso-8601=seconds)] task=$ARRAY_INDEX N=17 second_neighbor=true WD_source=true $SCAN_LINE checkpoint=each_momentum mem=256gb ncpus=16" | tee -a "$LOG"
"$PYTHON_BIN" scripts/run_three_ring_activation_resolved.py \
  --case-index "$ARRAY_INDEX" \
  --n 17 \
  --config "$CONFIG" \
  --output-root "$RUN_ROOT" \
  --resume 2>&1 | tee -a "$LOG"
