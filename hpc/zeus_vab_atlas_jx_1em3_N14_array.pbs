#!/bin/bash
# Original 880-case Vab atlas with unscaled Jx=1e-3 and hz0=0.
#PBS -N vab_jx1em3_N14
#PBS -J 0-8
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=72:00:00
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
if [[ -f scripts/run_zeus_vab_atlas_jx_1em3_N14.py ]]; then
  REPO_ROOT="$PWD"
elif [[ -f ../scripts/run_zeus_vab_atlas_jx_1em3_N14.py ]]; then
  REPO_ROOT="$(cd .. && pwd)"
else
  echo "Cannot locate the Jx=1e-3 atlas runner from $PWD" >&2
  exit 2
fi
cd "$REPO_ROOT"

: "${RUN_ROOT:?Submit with the documented wrapper or define RUN_ROOT}"
ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}"
if [[ ! "$ARRAY_INDEX" =~ ^[0-8]$ ]]; then
  echo "PBS array index must be 0..8; got '$ARRAY_INDEX'" >&2
  exit 2
fi

CONFIG_PATH="${CONFIG_PATH:-configs/zeus_vab_atlas_jx_1em3_N14.json}"
if [[ ! -f "$CONFIG_PATH" ]]; then
  echo "Missing configuration: $REPO_ROOT/$CONFIG_PATH" >&2
  exit 2
fi

mkdir -p "$RUN_ROOT/logs" "$RUN_ROOT/tmp/batch${ARRAY_INDEX}" \
  "$RUN_ROOT/.mplconfig/batch${ARRAY_INDEX}"
export PYTHONUNBUFFERED=1
export PYTHONHASHSEED=0
export MPLBACKEND=Agg
export TMPDIR="$RUN_ROOT/tmp/batch${ARRAY_INDEX}"
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig/batch${ARRAY_INDEX}"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export BLIS_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4

CONFIGURATION_COUNT=100
if [[ "$ARRAY_INDEX" == "8" ]]; then CONFIGURATION_COUNT=80; fi
LOG="$RUN_ROOT/logs/N14_batch${ARRAY_INDEX}_${PBS_JOBID:-manual}.log"
echo "[$(date --iso-8601=seconds)] array_index=$ARRAY_INDEX N=14 hz0=0 Jx_unscaled=1e-3 Jx_edge=1e-3/sqrt(14) Jy=0 t=1e6 configurations=$CONFIGURATION_COUNT row_workers=2" | tee -a "$LOG"

python3.11 scripts/run_zeus_vab_atlas_jx_1em3_N14.py \
  --batch-index "$ARRAY_INDEX" \
  --config "$CONFIG_PATH" \
  --output-root "$RUN_ROOT" \
  --workers 2 \
  --resume \
  2>&1 | tee -a "$LOG"

echo "[$(date --iso-8601=seconds)] array_index=$ARRAY_INDEX status=finished" | tee -a "$LOG"

