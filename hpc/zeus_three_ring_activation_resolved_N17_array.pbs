#!/bin/bash
# Activation-resolved projective diagnostics for three fixed N=17 rings.
# One array element owns one complete configuration and checkpoints every k.
#PBS -N ring_act_N17
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=16:mem=256gb
#PBS -l walltime=120:00:00
#PBS -J 0-2
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/examples/run_three_ring_activation_resolved.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../examples/run_three_ring_activation_resolved.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate activation-resolved runner. Submit from repository root or hpc/." >&2
  exit 2
fi
cd "$REPO_ROOT"

if [[ -n "${ZEUS_ENV_SETUP:-}" ]]; then source "$ZEUS_ENV_SETUP"; fi
if [[ -n "${VIRTUAL_ENV_PATH:-}" ]]; then source "$VIRTUAL_ENV_PATH/bin/activate"; fi

: "${RUN_ROOT:?submit through hpc/submit_zeus_three_ring_activation_resolved_N17.sh}"
ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:?PBS array index unavailable}}"
CONFIG="${CONFIG:-configs/three_ring_activation_resolved.json}"
PYTHON_BIN="${PYTHON_BIN:-python3.11}"
mkdir -p "$RUN_ROOT/logs" "$RUN_ROOT/.mplconfig/task_$ARRAY_INDEX"
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig/task_$ARRAY_INDEX"
export PYTHONUNBUFFERED=1
export PYTHONWARNINGS="${PYTHONWARNINGS:-ignore:.*font family.*not found.*,ignore:.*Glyph.*missing from font.*}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-16}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-16}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-16}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-16}"

LOG="$RUN_ROOT/logs/task_${ARRAY_INDEX}.log"
echo "[$(date --iso-8601=seconds)] task=$ARRAY_INDEX N=17 checkpoint=each_momentum mem=256gb ncpus=16" | tee -a "$LOG"
"$PYTHON_BIN" examples/run_three_ring_activation_resolved.py \
  --case-index "$ARRAY_INDEX" \
  --n 17 \
  --config "$CONFIG" \
  --output-root "$RUN_ROOT" \
  --resume 2>&1 | tee -a "$LOG"
