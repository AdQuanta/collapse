#!/bin/bash
#PBS -N sobol_hz009011_jpm0
#PBS -J 0-3
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
if [[ -f examples/run_zeus_sobol_hz0_0p1_jpm0_jy0_hz_0p09_0p11_N15.py ]]; then
  REPO_ROOT="$PWD"
elif [[ -f ../examples/run_zeus_sobol_hz0_0p1_jpm0_jy0_hz_0p09_0p11_N15.py ]]; then
  REPO_ROOT="$(cd .. && pwd)"
else
  echo "Cannot locate the fixed-Jpm fixed-hz-range Sobol runner from $PWD" >&2
  exit 2
fi
cd "$REPO_ROOT"

: "${RUN_ROOT:?Submit with qsub -v RUN_ROOT=/absolute/path/to/new_campaign hpc/zeus_sobol_hz0_0p1_jpm0_jy0_hz_0p09_0p11_N15_array.pbs}"
BATCH_INDEX="${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is not set}"
mkdir -p "$RUN_ROOT/logs" "$RUN_ROOT/tmp/batch${BATCH_INDEX}" "$RUN_ROOT/.mplconfig/batch${BATCH_INDEX}"

export PYTHONUNBUFFERED=1
export PYTHONHASHSEED=0
export TMPDIR="$RUN_ROOT/tmp/batch${BATCH_INDEX}"
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig/batch${BATCH_INDEX}"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export BLIS_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4

LOG="$RUN_ROOT/logs/jpm0_jy0_hz0p09_0p11_N15_batch${BATCH_INDEX}_${PBS_JOBID:-manual}.log"
echo "[$(date --iso-8601=seconds)] batch=$BATCH_INDEX N=15 hz0=0.1 hz=[0.09,0.11] Jpm=0 Jy=0 workers=2" | tee -a "$LOG"

python3.11 examples/run_zeus_sobol_hz0_0p1_jpm0_jy0_hz_0p09_0p11_N15.py \
  --batch-index "$BATCH_INDEX" \
  --output-root "$RUN_ROOT" \
  --lower 1e-3 --upper 10 --kappa 0.1 \
  --evolution-time 1e6 --workers 2 --resume \
  2>&1 | tee -a "$LOG"

echo "[$(date --iso-8601=seconds)] batch=$BATCH_INDEX status=finished" | tee -a "$LOG"

