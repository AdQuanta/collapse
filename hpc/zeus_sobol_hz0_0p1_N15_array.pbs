#!/bin/bash
#PBS -N sobol_hz0p1_N15
#PBS -J 0-7
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
if [[ -f scripts/run_zeus_sobol_hz0_0p1_N15.py ]]; then
  REPO_ROOT="$PWD"
elif [[ -f ../scripts/run_zeus_sobol_hz0_0p1_N15.py ]]; then
  REPO_ROOT="$(cd .. && pwd)"
else
  echo "Cannot locate scripts/run_zeus_sobol_hz0_0p1_N15.py from $PWD" >&2
  exit 2
fi
cd "$REPO_ROOT"

: "${RUN_ROOT:?Submit with qsub -v RUN_ROOT=/absolute/path/to/new_campaign hpc/zeus_sobol_hz0_0p1_N15_array.pbs}"
ARRAY_INDEX="${PBS_ARRAY_INDEX:?PBS_ARRAY_INDEX is not set}"
if (( ARRAY_INDEX < 4 )); then
  FAMILY="jy_zero"
  BATCH_INDEX="$ARRAY_INDEX"
else
  FAMILY="jy_nonzero"
  BATCH_INDEX="$((ARRAY_INDEX - 4))"
fi

mkdir -p "$RUN_ROOT/logs" "$RUN_ROOT/tmp/${FAMILY}_batch${BATCH_INDEX}" "$RUN_ROOT/.mplconfig/${FAMILY}_batch${BATCH_INDEX}"
export PYTHONUNBUFFERED=1
export PYTHONHASHSEED=0
export TMPDIR="$RUN_ROOT/tmp/${FAMILY}_batch${BATCH_INDEX}"
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig/${FAMILY}_batch${BATCH_INDEX}"
export OMP_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export BLIS_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4

LOG="$RUN_ROOT/logs/${FAMILY}_N15_batch${BATCH_INDEX}_${PBS_JOBID:-manual}.log"
echo "[$(date --iso-8601=seconds)] array_index=$ARRAY_INDEX family=$FAMILY batch=$BATCH_INDEX N=15 hz0=0.1 workers=2" | tee -a "$LOG"

python3.11 scripts/run_zeus_sobol_hz0_0p1_N15.py \
  --family "$FAMILY" \
  --batch-index "$BATCH_INDEX" \
  --output-root "$RUN_ROOT" \
  --lower 1e-3 --upper 10 --kappa 0.1 \
  --evolution-time 1e6 --workers 2 --resume \
  2>&1 | tee -a "$LOG"

echo "[$(date --iso-8601=seconds)] family=$FAMILY batch=$BATCH_INDEX status=finished" | tee -a "$LOG"

