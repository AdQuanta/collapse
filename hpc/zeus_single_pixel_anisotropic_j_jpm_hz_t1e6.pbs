#!/bin/bash
# Single-pixel anisotropic J--Jpm--hz production array.
# One task owns one N. Process workers compute different (hz, J, Jpm)
# configurations concurrently, checkpointing and plotting every completion.
# The supplied configuration has 8 tasks and 7,040 total Hamiltonians.
#PBS -N sp_aniso_jjpm
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=72:00:00
#PBS -J 11-18
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/examples/run_single_pixel_anisotropic_sweep.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../examples/run_single_pixel_anisotropic_sweep.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate examples/run_single_pixel_anisotropic_sweep.py from PBS_O_WORKDIR=$SUBMIT_DIR." >&2
  echo "Submit from the repository root or hpc/ after synchronizing the new files to Zeus." >&2
  exit 2
fi
cd "$REPO_ROOT"

if [[ -n "${ZEUS_ENV_SETUP:-}" ]]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi
if [[ -n "${PYTHON_MODULES:-}" ]]; then
  if ! command -v module >/dev/null 2>&1; then
    echo "PYTHON_MODULES is set, but the module command is unavailable." >&2
    exit 2
  fi
  for mod in $PYTHON_MODULES; do module load "$mod"; done
fi
if [[ -n "${VIRTUAL_ENV_PATH:-}" ]]; then
  # shellcheck source=/dev/null
  source "$VIRTUAL_ENV_PATH/bin/activate"
fi

PYTHON_BIN="${PYTHON_BIN:-python3.11}"
CONFIG_PATH="${CONFIG_PATH:-configs/zeus_single_pixel_anisotropic_j_jpm_hz_t1e6.json}"
RUN_ROOT="${RUN_ROOT:-work/zeus_single_pixel_anisotropic_j_jpm_hz_t1e6}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_single_pixel_anisotropic_j_jpm_hz_t1e6}"
TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TASK_ID:-}}}"
if [[ -z "$TASK_ID" || ! "$TASK_ID" =~ ^(11|12|13|14|15|16|17|18)$ ]]; then
  echo "PBS array index must select N=11..18; got '$TASK_ID'." >&2
  exit 2
fi
if [[ ! -f "$CONFIG_PATH" ]]; then
  echo "Missing configuration: $REPO_ROOT/$CONFIG_PATH" >&2
  exit 2
fi

mkdir -p "$RUN_ROOT" "$LOG_ROOT" "$RUN_ROOT/.mplconfig"
export MPLBACKEND=Agg
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig"
export PYTHONUNBUFFERED=1
NUMERIC_THREADS="${NUMERIC_THREADS:-2}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-$NUMERIC_THREADS}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-$NUMERIC_THREADS}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-$NUMERIC_THREADS}"
export BLIS_NUM_THREADS="${BLIS_NUM_THREADS:-$NUMERIC_THREADS}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-$NUMERIC_THREADS}"

JOB_TAG="${PBS_JOBID:-manual}"
TASK_LOG="$LOG_ROOT/task_${TASK_ID}_${JOB_TAG}.log"
exec >"$TASK_LOG" 2>&1

echo "[$(date --iso-8601=seconds)] starting anisotropic N=$TASK_ID"
echo "REPO_ROOT=$REPO_ROOT"
echo "CONFIG_PATH=$CONFIG_PATH"
echo "RUN_ROOT=$RUN_ROOT"
echo "TASK_LOG=$TASK_LOG"
echo "PYTHON_BIN=$PYTHON_BIN"
echo "NUMERIC_THREADS=$NUMERIC_THREADS"
echo "CONFIG_WORKERS=${CONFIG_WORKERS:-0} (0 selects 4 workers for N<=13, 2 for N=14..15, 1 for N>=16)"
echo "COLLECTIVE_JX=0.01"
echo "EDGE_COUPLING_FORMULA=0.01/sqrt(N)"

"$PYTHON_BIN" -c 'import sys; assert sys.version_info[:2] == (3, 11), sys.version; import importlib.metadata as m; expected={"quspin":"1.0.0","quspin-extensions":"0.1.6"}; actual={k:m.version(k) for k in expected}; assert actual == expected, actual; print(sys.version); print(actual)'

if [[ "${SMOKE:-0}" == "1" && "$TASK_ID" != "11" ]]; then
  echo "SMOKE=1: only array index 11 runs; safely skipping N=$TASK_ID."
  exit 0
fi

GLOBAL_ARGS=(--config "$CONFIG_PATH" --run-root "$RUN_ROOT")
RUN_N="$TASK_ID"
if [[ "${SMOKE:-0}" == "1" ]]; then GLOBAL_ARGS+=(--smoke); RUN_N=4; fi
TASK_ARGS=(simulate-N --N "$RUN_N" --workers "${CONFIG_WORKERS:-0}")
if [[ "${DRY_RUN:-0}" == "1" ]]; then TASK_ARGS+=(--dry-run); fi
if [[ "${FORCE:-0}" == "1" ]]; then TASK_ARGS+=(--force); fi

trap 'echo "[$(date --iso-8601=seconds)] interrupted task '$TASK_ID'"; exit 143' TERM INT
"$PYTHON_BIN" examples/run_single_pixel_anisotropic_sweep.py "${GLOBAL_ARGS[@]}" "${TASK_ARGS[@]}"

echo "[$(date --iso-8601=seconds)] finished anisotropic N=$RUN_N"
echo "Outputs: $RUN_ROOT"
echo "Log: $TASK_LOG"
