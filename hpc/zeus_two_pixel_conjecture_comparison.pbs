#!/bin/bash
# Equal-Hilbert-space single/two-pixel comparison across all four conjecture grids.
#PBS -N two_pixel_conjectures
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=72:00:00
#PBS -J 10,12,14
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/examples/compare_two_pixel_conjecture_families.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../examples/compare_two_pixel_conjecture_families.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate the repository from PBS_O_WORKDIR=$SUBMIT_DIR." >&2
  echo "Submit from the repository root or its hpc/ directory." >&2
  exit 2
fi
cd "$REPO_ROOT"

if [[ -n "${ZEUS_ENV_SETUP:-}" ]]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi
if [[ -n "${VIRTUAL_ENV_PATH:-}" ]]; then
  # shellcheck source=/dev/null
  source "$VIRTUAL_ENV_PATH/bin/activate"
fi

PYTHON_BIN="${PYTHON_BIN:-python3.11}"
TASK_N="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TASK_N:-}}}"
if [[ -z "$TASK_N" || ! "$TASK_N" =~ ^(10|12|14)$ ]]; then
  echo "PBS array index must be 10, 12, or 14; got '$TASK_N'." >&2
  exit 2
fi

RUN_ROOT="${RUN_ROOT:-work/zeus_two_pixel_conjecture_comparison}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_two_pixel_conjecture_comparison}"
RUN_N="$TASK_N"
if [[ "${SMOKE:-0}" == "1" ]]; then
  RUN_N=6
  RUN_ROOT="$RUN_ROOT/smoke_task_N${TASK_N}"
fi

TASK_ROOT="$RUN_ROOT/ND${RUN_N}"
RAW_ROOT="$TASK_ROOT/raw"
FIG_ROOT="$TASK_ROOT/figures"
mkdir -p "$RAW_ROOT" "$FIG_ROOT" "$LOG_ROOT"
LOG_FILE="$LOG_ROOT/ND${RUN_N}_${PBS_JOBID:-manual}.log"
exec >"$LOG_FILE" 2>&1

export MPLBACKEND=Agg
export MPLCONFIGDIR="${MPLCONFIGDIR:-$TASK_ROOT/.mplconfig}"
mkdir -p "$MPLCONFIGDIR"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"

echo "[$(date --iso-8601=seconds)] Starting detector N_D=$RUN_N"
echo "REPO_ROOT=$REPO_ROOT"
echo "RAW_ROOT=$RAW_ROOT"
echo "FIG_ROOT=$FIG_ROOT"
echo "LOG_FILE=$LOG_FILE"
echo "COLLECTIVE_JX=0.01"
echo "EDGE_COUPLING_FORMULA=0.01/sqrt(N_D)"

"$PYTHON_BIN" -c 'import sys; assert sys.version_info[:2] == (3, 11), sys.version; import importlib.metadata as m; expected={"quspin":"1.0.0","quspin-extensions":"0.1.6"}; actual={k:m.version(k) for k in expected}; assert actual == expected, actual; print(sys.version); print(actual)'

COMMAND=(
  "$PYTHON_BIN" examples/compare_two_pixel_conjecture_families.py
  --detector-spins "$RUN_N"
  --workers "${MODEL_WORKERS:-1}"
  --raw-out "$RAW_ROOT"
  --fig-out "$FIG_ROOT"
)

if [[ "${DRY_RUN:-0}" == "1" ]]; then
  printf 'DRY RUN:'
  printf ' %q' "${COMMAND[@]}"
  printf '\n'
  exit 0
fi
if [[ "${FORCE:-0}" == "1" ]]; then
  COMMAND+=(--force)
fi

trap 'date --iso-8601=seconds > "$TASK_ROOT/INTERRUPTED"; exit 143' TERM INT
"${COMMAND[@]}"

test "$(find "$RAW_ROOT" -type f -name 'raw_t*.npz' | wc -l)" -eq 472
test "$(find "$FIG_ROOT" -type f -name '*.png' | wc -l)" -eq 31
test -f "$FIG_ROOT/manifest.json"
date --iso-8601=seconds > "$TASK_ROOT/DONE"
rm -f "$TASK_ROOT/INTERRUPTED"
echo "[$(date --iso-8601=seconds)] Completed detector N_D=$RUN_N"
