#!/bin/bash
# PBS array for pairwise Born-stability heatmaps around selected candidate points.
#
# The tasks deliberately default to BORN_WORKERS=2 because N15/N16 pairwise
# sweeps can hold multiple large diagonalizations in memory at once. Increase
# BORN_WORKERS manually only after checking memory headroom in scheduler logs.
#
#PBS -N born_heatmaps
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -J 1-5
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

PBS_O_WORKDIR="${PBS_O_WORKDIR:-$HOME/research/collapse}"
cd "$PBS_O_WORKDIR"

if [ -n "${ZEUS_ENV_SETUP:-}" ]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi

if [ -n "${PYTHON_MODULES:-}" ]; then
  if ! command -v module >/dev/null 2>&1; then
    echo "PYTHON_MODULES was set, but the module command is unavailable." >&2
    exit 2
  fi
  for mod in $PYTHON_MODULES; do
    module load "$mod"
  done
fi

if [ -n "${VIRTUAL_ENV_PATH:-}" ]; then
  # shellcheck source=/dev/null
  source "$VIRTUAL_ENV_PATH/bin/activate"
fi

export PYTHONUNBUFFERED=1
export BORN_WORKERS="${BORN_WORKERS:-2}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"

PYTHON_BIN="${PYTHON_BIN:-python3.11}"
TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TASK_ID:-1}}}"
RUN_ROOT="${RUN_ROOT:-figures/zeus_born_pairwise_heatmaps}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_born_pairwise_heatmaps}"
PLOT_TOP="${PLOT_TOP:-8}"
PLOT_MAX_BLOCH_POINTS="${PLOT_MAX_BLOCH_POINTS:-6000}"
MAX_DETECTOR_SPECTRUM_QUBITS="${MAX_DETECTOR_SPECTRUM_QUBITS:-12}"

mkdir -p "$RUN_ROOT" "$LOG_ROOT"

COMMON_ARGS=(
  --backend quspin
  --bins 100
  --tail-fraction 0.10
  --log-bins 50
  --energy-degeneracy-tol 1e-9
  --workers "$BORN_WORKERS"
  --plot-top "$PLOT_TOP"
  --plot-max-bloch-points "$PLOT_MAX_BLOCH_POINTS"
  --max-detector-spectrum-qubits "$MAX_DETECTOR_SPECTRUM_QUBITS"
  --born-colormap RdYlGn
)

case "$TASK_ID" in
  1)
    RUN_NAME="matched_ring_N15_Jx_hz"
    ARGS=(
      --model single_pixel
      --N 15
      --connectivity ring
      --central-coupling all
      --hz0-mode matched
      --J 1.0
      --Jpm 0.05
      --jx-unscaled 0.04
      --hz 0.1
      --times 1000 3162 10000
      --x-param jx
      --x-values 0.030 0.035 0.040 0.045 0.050
      --y-param hz
      --y-values 0.080 0.090 0.100 0.110 0.120
    )
    ;;
  2)
    RUN_NAME="zero_ring_slide8_Jpm_Jx_N15"
    ARGS=(
      --model single_pixel
      --N 15
      --connectivity ring
      --central-coupling all
      --hz0-mode zero
      --J 1.0
      --Jpm 0.05
      --jx-unscaled 0.04
      --hz 0.1
      --times 1000 3162 10000
      --x-param Jpm
      --x-values 0 0.025 0.050 0.075 0.100
      --y-param jx
      --y-values 0.020 0.030 0.040 0.050 0.060
    )
    ;;
  3)
    RUN_NAME="anisotropic_ring_Jxx_Jyy_N15"
    ARGS=(
      --model single_pixel
      --N 15
      --connectivity ring
      --central-coupling all
      --hz0-mode matched
      --J 1.0
      --Jpm 0
      --jx-unscaled 0.04
      --hz 0.1
      --times 1000 3162
      --x-param Jxx
      --x-values 0 0.015 0.030 0.045 0.060
      --y-param Jyy
      --y-values 0 0.015 0.030 0.045 0.060
    )
    ;;
  4)
    RUN_NAME="weak_disorder_ring_dJ_dhz_N15"
    ARGS=(
      --model single_pixel
      --N 15
      --connectivity ring
      --central-coupling all
      --hz0-mode matched
      --disorder uniform
      --J 1.0
      --Jpm 0.05
      --jx-unscaled 0.04
      --hz 0.1
      --times 1000 3162
      --x-param disorder_strength_J
      --x-values 0 0.0025 0.0050 0.0100 0.0200
      --y-param disorder_strength_hz
      --y-values 0 0.0025 0.0050 0.0100 0.0200
    )
    ;;
  5)
    RUN_NAME="degenerate_flat_lift_Jx_hz_N13"
    ARGS=(
      --model single_pixel
      --N 13
      --connectivity ring
      --central-coupling all
      --hz0-mode zero
      --J 0
      --Jpm 0
      --jx-unscaled 0.02
      --hz 0.02
      --times 316 1000 3162
      --x-param jx
      --x-values 0.005 0.010 0.020 0.030 0.040
      --y-param hz
      --y-values 0 0.010 0.020 0.050 0.100
    )
    ;;
  *)
    echo "Unknown pairwise heatmap TASK_ID: $TASK_ID" >&2
    echo "Valid task ids are 1 through 5." >&2
    exit 2
    ;;
esac

OUT_DIR="$RUN_ROOT/$RUN_NAME"
RUN_LOG="$LOG_ROOT/${RUN_NAME}.${PBS_JOBID:-local}.${TASK_ID}.log"
OUT_LOG="$OUT_DIR/run.log"

mkdir -p "$OUT_DIR"

timestamp_stream() {
  awk 'BEGIN { ts_re="^\[[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T" } $0 ~ ts_re { print; fflush(); next } { print strftime("[%Y-%m-%dT%H:%M:%S%z]"), $0; fflush(); }'
}

exec > >(timestamp_stream | tee "$RUN_LOG") 2>&1

ensure_output_log_on_exit() {
  status=$?
  if [ ! -s "$OUT_LOG" ] && [ -s "$RUN_LOG" ]; then
    cp "$RUN_LOG" "$OUT_LOG"
  fi
  exit "$status"
}
trap ensure_output_log_on_exit EXIT

echo "Host: $(hostname)"
echo "Task: $TASK_ID"
echo "Run: $RUN_NAME"
echo "Output: $OUT_DIR"
echo "Scheduler-side log: $RUN_LOG"
echo "Per-output run.log: $OUT_LOG"
echo "Workdir: $(pwd)"
echo "Python command: $PYTHON_BIN"
echo "Python version: $("$PYTHON_BIN" --version 2>&1)"
echo "BORN_WORKERS: $BORN_WORKERS"
echo "MAX_DETECTOR_SPECTRUM_QUBITS: $MAX_DETECTOR_SPECTRUM_QUBITS"
echo "OMP/MKL/OPENBLAS/NUMEXPR threads: $OMP_NUM_THREADS/$MKL_NUM_THREADS/$OPENBLAS_NUM_THREADS/$NUMEXPR_NUM_THREADS"

"$PYTHON_BIN" examples/born_pairwise_heatmap.py \
  "${ARGS[@]}" \
  "${COMMON_ARGS[@]}" \
  --out-dir "$OUT_DIR" \
  --log-file "$OUT_LOG"
