#!/bin/bash
# Top 400 S_born cases from the 880-case atlas, scanned over central fields.
# Each array shard owns one hundred source cases and saves every (case,hz0) result.
#PBS -N top400_hz0
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=120:00:00
#PBS -J 0-3
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/scripts/run_zeus_top400_hz0_variants_N14.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../scripts/run_zeus_top400_hz0_variants_N14.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate the hz0-variant runner. Submit from the repository root or hpc/." >&2
  exit 2
fi
cd "$REPO_ROOT"

if [[ -n "${ZEUS_ENV_SETUP:-}" ]]; then source "$ZEUS_ENV_SETUP"; fi
if [[ -n "${VIRTUAL_ENV_PATH:-}" ]]; then source "$VIRTUAL_ENV_PATH/bin/activate"; fi

: "${RUN_ROOT:?submit through hpc/submit_zeus_top400_hz0_variants_N14.sh}"
BATCH_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:?PBS array index unavailable}}"
CONFIG="${CONFIG:-configs/zeus_top400_hz0_variants_N14.json}"
WORKERS="${WORKERS:-2}"
PYTHON_BIN="${PYTHON_BIN:-python3.11}"
mkdir -p "$RUN_ROOT/logs" "$RUN_ROOT/.mplconfig/batch_$BATCH_INDEX"
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig/batch_$BATCH_INDEX"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-4}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-4}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-4}"

LOG="$RUN_ROOT/logs/batch_${BATCH_INDEX}.log"
echo "[$(date --iso-8601=seconds)] batch=$BATCH_INDEX top=400 N=14 shard=100 hz0=0,hz+offset workers=$WORKERS" | tee -a "$LOG"
"$PYTHON_BIN" scripts/run_zeus_top400_hz0_variants_N14.py \
  --batch-index "$BATCH_INDEX" \
  --config "$CONFIG" \
  --output-root "$RUN_ROOT" \
  --workers "$WORKERS" \
  --resume 2>&1 | tee -a "$LOG"
