#!/bin/bash
# PBS array for finite-time weak-kernel diagnostics.
#
# Goal: test whether the weak-coupling kernel K_t predicts the exact M(t)
# Born-rule scores for hz0=0 and matched controls in the ZZ + Jpm detector
# family.  This script intentionally stays at N<=13 because the current
# implementation constructs dense central-qubit blocks.
#
#PBS -N born_weak_kernel
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -J 1-8
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

PBS_O_WORKDIR="${PBS_O_WORKDIR:-$HOME/research/collapse}"
cd "$PBS_O_WORKDIR"

if [ -n "${ZEUS_ENV_SETUP:-}" ]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi

if [ -n "${PYTHON_MODULES:-}" ]; then
  if ! command -v module >/dev/null 2>&1; then
    echo "PYTHON_MODULES was set, but the module command is unavailable." >&2
    exit 2
  fi
  for mod in $PYTHON_MODULES; do
    module load "$mod"
  done
fi

if [ -n "${VIRTUAL_ENV_PATH:-}" ]; then
  # shellcheck source=/dev/null
  source "$VIRTUAL_ENV_PATH/bin/activate"
fi

export PYTHONUNBUFFERED=1
if [ -n "${PBS_NODEFILE:-}" ] && [ -r "$PBS_NODEFILE" ]; then
  PBS_NP_DEFAULT="$(wc -l < "$PBS_NODEFILE")"
else
  PBS_NP_DEFAULT="${PBS_NP:-8}"
fi
export BORN_WORKERS="${BORN_WORKERS:-$PBS_NP_DEFAULT}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"

PYTHON_BIN="${PYTHON_BIN:-python3.11}"
TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TASK_ID:-1}}}"
RUN_ROOT="${RUN_ROOT:-figures/zeus_detector_weak_kernel_diagnostics}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_detector_weak_kernel_diagnostics}"

mkdir -p "$RUN_ROOT" "$LOG_ROOT"

timestamp_stream() {
  awk 'BEGIN { ts_re="^\[[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T" } $0 ~ ts_re { print; fflush(); next } { print strftime("[%Y-%m-%dT%H:%M:%S%z]"), $0; fflush(); }'
}

case "$TASK_ID" in
  1) RUN_NAME="ring_all_N10_reference" ;;
  2) RUN_NAME="ring_all_N11_scaling" ;;
  3) RUN_NAME="ring_all_N12_scaling" ;;
  4) RUN_NAME="ring_all_N13_dense_limit" ;;
  5) RUN_NAME="ring_all_N12_anisotropic_weak" ;;
  6) RUN_NAME="ring_first_N12_coupling_control" ;;
  7) RUN_NAME="ring_ends_N12_coupling_control" ;;
  8) RUN_NAME="chain_all_N12_geometry_control" ;;
  *)
    echo "Unknown weak-kernel TASK_ID: $TASK_ID" >&2
    echo "Valid task ids are 1 through 8." >&2
    exit 2
    ;;
esac

RUN_LOG="$LOG_ROOT/${RUN_NAME}.${PBS_JOBID:-local}.${TASK_ID}.log"
TASK_OUT_DIR="$RUN_ROOT/$RUN_NAME"
TASK_OUT_LOG="$TASK_OUT_DIR/run.log"
mkdir -p "$TASK_OUT_DIR"

exec > >(timestamp_stream | tee "$RUN_LOG") 2>&1

ensure_task_output_log_on_exit() {
  status=$?
  if [ ! -s "$TASK_OUT_LOG" ] && [ -s "$RUN_LOG" ]; then
    cp "$RUN_LOG" "$TASK_OUT_LOG"
  fi
  exit "$status"
}
trap ensure_task_output_log_on_exit EXIT

echo "Host: $(hostname)"
echo "Task: $TASK_ID"
echo "Run: $RUN_NAME"
echo "Run root: $RUN_ROOT"
echo "Scheduler-side log: $RUN_LOG"
echo "Task output run.log: $TASK_OUT_LOG"
echo "Workdir: $(pwd)"
echo "Python command: $PYTHON_BIN"
echo "Python version: $("$PYTHON_BIN" --version 2>&1)"
echo "BORN_WORKERS: $BORN_WORKERS"
echo "OMP/MKL/OPENBLAS/NUMEXPR threads: $OMP_NUM_THREADS/$MKL_NUM_THREADS/$OPENBLAS_NUM_THREADS/$NUMEXPR_NUM_THREADS"

COMMON_ARGS=(
  --model single_pixel
  --J 1.0
  --hz 0.1
  --hz0-modes zero matched
  --Jpm 0 0.05
  --Jxx 0
  --Jyy 0
  --Jz 0
  --Jzx 0
  --jx-unscaled 0.05
  --jy-unscaled 0
  --jcpm-unscaled 0
  --hx 0
  --times 1000 3162
  --m-backend numpy
  --n-theta 100
  --tail-fraction 0.10
  --log-bins 50
  --bins 180
  --workers "$BORN_WORKERS"
  --compute-kernel-diagnostics
)

run_diag() {
  local run_name="$1"
  shift
  local out_dir="$RUN_ROOT/$run_name"
  mkdir -p "$out_dir"

  echo
  echo "=== Weak-kernel diagnostic: $run_name ==="
  echo "Output: $out_dir"
  echo "Output run.log: $out_dir/run.log"
  "$PYTHON_BIN" examples/detector_spectral_response.py \
    "${COMMON_ARGS[@]}" \
    "$@" \
    --out-dir "$out_dir" \
    --log-file "$out_dir/run.log"
}

case "$TASK_ID" in
  1)
    run_diag "$RUN_NAME" --N 10 --connectivity ring --central-coupling all
    ;;
  2)
    run_diag "$RUN_NAME" --N 11 --connectivity ring --central-coupling all
    ;;
  3)
    run_diag "$RUN_NAME" --N 12 --connectivity ring --central-coupling all
    ;;
  4)
    run_diag "$RUN_NAME" --N 13 --connectivity ring --central-coupling all
    ;;
  5)
    run_diag "$RUN_NAME" --N 12 --connectivity ring --central-coupling all --Jxx 0.02 --Jyy 0.01
    ;;
  6)
    run_diag "$RUN_NAME" --N 12 --connectivity ring --central-coupling first
    ;;
  7)
    run_diag "$RUN_NAME" --N 12 --connectivity ring --central-coupling ends
    ;;
  8)
    run_diag "$RUN_NAME" --N 12 --connectivity chain --central-coupling all
    ;;
esac

echo
echo "Completed $RUN_NAME"
