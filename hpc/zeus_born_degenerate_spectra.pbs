#!/bin/bash
# PBS array for Hamiltonian candidates with exact or near-exact detector
# eigenenergy degeneracies.
#
# The goal is to test whether degenerate spectra can produce heavy-tailed
# P(theta) and a Born-like R(theta), while keeping central detector couplings
# perturbative and recording atom/degen diagnostics.
#
#PBS -N born_degen
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=96gb
#PBS -J 1-6
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

PBS_O_WORKDIR="${PBS_O_WORKDIR:-$HOME/research/collapse}"
cd "$PBS_O_WORKDIR"

if [ -n "${ZEUS_ENV_SETUP:-}" ]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi

if [ -n "${PYTHON_MODULES:-}" ]; then
  if ! command -v module >/dev/null 2>&1; then
    echo "PYTHON_MODULES was set, but the module command is unavailable." >&2
    exit 2
  fi
  for mod in $PYTHON_MODULES; do
    module load "$mod"
  done
fi

if [ -n "${VIRTUAL_ENV_PATH:-}" ]; then
  # shellcheck source=/dev/null
  source "$VIRTUAL_ENV_PATH/bin/activate"
fi

export PYTHONUNBUFFERED=1
if [ -n "${PBS_NODEFILE:-}" ] && [ -r "$PBS_NODEFILE" ]; then
  PBS_NP_DEFAULT="$(wc -l < "$PBS_NODEFILE")"
else
  PBS_NP_DEFAULT="${PBS_NP:-8}"
fi
export BORN_WORKERS="${BORN_WORKERS:-$PBS_NP_DEFAULT}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"

PYTHON_BIN="${PYTHON_BIN:-python3.11}"
TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TASK_ID:-1}}}"
RUN_ROOT="${RUN_ROOT:-figures/zeus_born_degenerate_spectra}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_born_degenerate_spectra}"
PLOT_TOP="${PLOT_TOP:-12}"
PLOT_MAX_BLOCH_POINTS="${PLOT_MAX_BLOCH_POINTS:-6000}"

mkdir -p "$RUN_ROOT" "$LOG_ROOT"

COMMON_ARGS=(
  --bins 120
  --tail-fraction 0.10
  --log-bins 60
  --energy-degeneracy-tol 1e-9
  --top 40
  --workers "$BORN_WORKERS"
  --plot-top "$PLOT_TOP"
  --plot-max-bloch-points "$PLOT_MAX_BLOCH_POINTS"
)

case "$TASK_ID" in
  1)
    RUN_NAME="flat_detector_exact_degenerate_ring_N13_N14"
    ARGS=(
      --model single_pixel
      --N 13 14
      --connectivity ring
      --times 100 316 1000 3162 10000
      --J 0
      --Jpm 0
      --jx-unscaled 0.005 0.01 0.02 0.04
      --central-coupling all first ends
      --jy-unscaled 0
      --hz 0
      --hz0-modes matched
      --backend quspin
    )
    ;;
  2)
    RUN_NAME="flat_detector_weak_field_lift_ring_N13_N14"
    ARGS=(
      --model single_pixel
      --N 13 14
      --connectivity ring
      --times 316 1000 3162 10000
      --J 0
      --Jpm 0 0.02
      --jx-unscaled 0.005 0.01 0.02 0.04
      --central-coupling all first ends
      --jy-unscaled 0
      --hz 0.02 0.05 0.1
      --hz0-modes matched zero
      --backend quspin
    )
    ;;
  3)
    RUN_NAME="dimerized_zz_degenerate_N11_N13"
    ARGS=(
      --model dimerized_pixel
      --N 11 13
      --times 316 1000 3162 10000
      --J 1.0
      --jx-unscaled 0.005 0.01 0.02 0.04
      --central-coupling all first ends
      --Jz 0 0.02
      --hx 0
      --hz 0.05 0.1
      --hz0-modes matched zero
      --backend quspin
    )
    ;;
  4)
    RUN_NAME="dimerized_flat_lift_N11_N13"
    ARGS=(
      --model dimerized_pixel
      --N 11 13
      --times 100 316 1000 3162 10000
      --J 0
      --jx-unscaled 0.005 0.01 0.02 0.04
      --central-coupling all first ends
      --Jz 0 0.02
      --hx 0
      --hz 0 0.02 0.05
      --hz0-modes matched zero
      --backend quspin
    )
    ;;
  5)
    RUN_NAME="all_to_all_sz_degenerate_exchange_N15_N16"
    ARGS=(
      --model single_pixel
      --N 15 16
      --connectivity all_to_all
      --times 316 1000 3162 10000
      --J 1.0
      --Jpm 0 0.05
      --central-coupling all first
      --jx-unscaled 0
      --jy-unscaled 0
      --Jz 0 0.02
      --jcpm-unscaled 0.02 0.05
      --hz 0.05 0.1
      --hz0-modes matched zero
      --backend quspin
    )
    ;;
  6)
    RUN_NAME="cnot_copier_atomic_degenerate_N8_N10_N12"
    ARGS=(
      --model cnot_copier
      --N 8 10 12
      --times 1
      --backend auto
    )
    ;;
  *)
    echo "Unknown degenerate-spectra TASK_ID: $TASK_ID" >&2
    echo "Valid task ids are 1 through 6." >&2
    exit 2
    ;;
esac

OUT_DIR="$RUN_ROOT/$RUN_NAME"
RUN_LOG="$LOG_ROOT/${RUN_NAME}.${PBS_JOBID:-local}.${TASK_ID}.log"
OUT_LOG="$OUT_DIR/run.log"

mkdir -p "$OUT_DIR"

timestamp_stream() {
  awk 'BEGIN { ts_re="^\[[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T" } $0 ~ ts_re { print; fflush(); next } { print strftime("[%Y-%m-%dT%H:%M:%S%z]"), $0; fflush(); }'
}

exec > >(timestamp_stream | tee "$RUN_LOG") 2>&1

ensure_output_log_on_exit() {
  status=$?
  if [ ! -s "$OUT_LOG" ] && [ -s "$RUN_LOG" ]; then
    cp "$RUN_LOG" "$OUT_LOG"
  fi
  exit "$status"
}
trap ensure_output_log_on_exit EXIT

echo "Host: $(hostname)"
echo "Task: $TASK_ID"
echo "Run: $RUN_NAME"
echo "Output: $OUT_DIR"
echo "Scheduler-side log: $RUN_LOG"
echo "Per-output run.log: $OUT_LOG"
echo "Workdir: $(pwd)"
echo "Python command: $PYTHON_BIN"
echo "Python version: $("$PYTHON_BIN" --version 2>&1)"
echo "BORN_WORKERS: $BORN_WORKERS"
echo "OMP/MKL/OPENBLAS/NUMEXPR threads: $OMP_NUM_THREADS/$MKL_NUM_THREADS/$OPENBLAS_NUM_THREADS/$NUMEXPR_NUM_THREADS"

"$PYTHON_BIN" scripts/born_hamiltonian_search.py "${ARGS[@]}" "${COMMON_ARGS[@]}" --out-dir "$OUT_DIR" --log-file "$OUT_LOG"
