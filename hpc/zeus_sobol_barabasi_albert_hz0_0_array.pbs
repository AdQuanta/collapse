#!/bin/bash
#PBS -N sobol_ba_N12
#PBS -J 0-3
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=72:00:00
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?PBS_O_WORKDIR is not set}"
RUNNER="scripts/run_zeus_sobol_barabasi_albert_hz0_0.py"
CAMPAIGN_SLUG="sobol_barabasi_albert_hz0_0"
GRAPH_SEED="${GRAPH_SEED:-2026081301}"
GRAPH_ARGS=(--connectivity barabasi_albert --barabasi-albert-m "${BARABASI_ALBERT_M:-2}")
if [[ -f "hpc/zeus_sobol_network_array_common.sh" ]]; then source "hpc/zeus_sobol_network_array_common.sh"; else source "../hpc/zeus_sobol_network_array_common.sh"; fi
