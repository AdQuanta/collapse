#!/bin/bash
# PBS array for perturbative Born-rule searches with anisotropic XX/YY/ZZ
# detector interactions, larger N, and connectivity controls.
#
# Submit from the repository root on Zeus with:
#   qsub hpc/zeus_born_anisotropic_largerN.pbs
#
# Ring and all-to-all tasks carry the larger N=15/16 validations.  Chain
# branches are kept at N=13/14 after the earlier feasibility steering.
#
#PBS -N born_aniso_N
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=96gb
#PBS -J 1-9
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

PBS_O_WORKDIR="${PBS_O_WORKDIR:-$HOME/research/collapse}"
cd "$PBS_O_WORKDIR"

if [ -n "${ZEUS_ENV_SETUP:-}" ]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi

if [ -n "${PYTHON_MODULES:-}" ]; then
  if ! command -v module >/dev/null 2>&1; then
    echo "PYTHON_MODULES was set, but the module command is unavailable." >&2
    exit 2
  fi
  for mod in $PYTHON_MODULES; do
    module load "$mod"
  done
fi

if [ -n "${VIRTUAL_ENV_PATH:-}" ]; then
  # shellcheck source=/dev/null
  source "$VIRTUAL_ENV_PATH/bin/activate"
fi

export PYTHONUNBUFFERED=1
if [ -n "${PBS_NODEFILE:-}" ] && [ -r "$PBS_NODEFILE" ]; then
  PBS_NP_DEFAULT="$(wc -l < "$PBS_NODEFILE")"
else
  PBS_NP_DEFAULT="${PBS_NP:-8}"
fi
export BORN_WORKERS="${BORN_WORKERS:-$PBS_NP_DEFAULT}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"

PYTHON_BIN="${PYTHON_BIN:-python3.11}"
TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TASK_ID:-1}}}"
RUN_ROOT="${RUN_ROOT:-figures/zeus_born_anisotropic_largerN}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_born_anisotropic_largerN}"
PLOT_TOP="${PLOT_TOP:-12}"
PLOT_MAX_BLOCH_POINTS="${PLOT_MAX_BLOCH_POINTS:-6000}"

mkdir -p "$RUN_ROOT" "$LOG_ROOT"

COMMON_ARGS=(
  --bins 100
  --tail-fraction 0.10
  --log-bins 50
  --backend quspin
  --top 40
  --workers "$BORN_WORKERS"
  --plot-top "$PLOT_TOP"
  --plot-max-bloch-points "$PLOT_MAX_BLOCH_POINTS"
)

case "$TASK_ID" in
  1)
    RUN_NAME="ring_baseline_matched_N15_N16"
    ARGS=(
      --N 15 16
      --connectivity ring
      --times 316 1000 3162 10000
      --J 1.0
      --Jpm 0 0.05 0.1
      --jx-unscaled 0.03 0.04 0.05
      --jy-unscaled 0
      --hz 0.08 0.1 0.12
      --hz0-modes matched
    )
    ;;
  2)
    RUN_NAME="ring_anisotropic_xx_yy_N15_N16"
    ARGS=(
      --N 15 16
      --connectivity ring
      --times 1000 3162 10000
      --J 1.0
      --Jpm 0
      --Jxx 0 0.02 0.05
      --Jyy 0 0.02 0.05 0.08
      --jx-unscaled 0.04 0.05
      --jy-unscaled 0
      --hz 0.08 0.1
      --hz0-modes matched
    )
    ;;
  3)
    RUN_NAME="ring_weak_zz_anisotropic_N15_N16"
    ARGS=(
      --N 15 16
      --connectivity ring
      --times 1000 3162
      --J 0.75
      --Jpm 0 0.05 0.1
      --Jxx 0 0.03
      --Jyy 0 0.03
      --jx-unscaled 0.04 0.05
      --jy-unscaled 0
      --hz 0.08 0.1
      --hz0-modes matched
    )
    ;;
  4)
    RUN_NAME="ring_strong_zz_anisotropic_N15_N16"
    ARGS=(
      --N 15 16
      --connectivity ring
      --times 1000 3162
      --J 1.25
      --Jpm 0 0.05
      --Jxx 0 0.03
      --Jyy 0 0.03
      --jx-unscaled 0.04 0.05
      --jy-unscaled 0
      --hz 0.08 0.1
      --hz0-modes matched
    )
    ;;
  5)
    RUN_NAME="ring_central_coupling_channels_N15_N16"
    ARGS=(
      --N 15 16
      --connectivity ring
      --times 1000 3162 10000
      --J 1.0
      --Jpm 0
      --jx-unscaled 0.04
      --jy-unscaled 0 0.04
      --Jz 0 0.03
      --Jzx 0 0.03
      --jcpm-unscaled 0 0.04
      --hz 0.1
      --hz0-modes matched
    )
    ;;
  6)
    RUN_NAME="chain_sz_conserving_N13_N14"
    ARGS=(
      --N 13 14
      --connectivity chain
      --times 1000 3162 10000
      --J 1.0
      --Jpm 0 0.05 0.1
      --jx-unscaled 0
      --jy-unscaled 0
      --Jz 0 0.03
      --Jzx 0
      --jcpm-unscaled 0.02 0.05
      --hz 0.08 0.1
      --hz0-modes matched zero
    )
    ;;
  7)
    RUN_NAME="chain_transverse_perturbative_N13_N14"
    ARGS=(
      --N 13 14
      --connectivity chain
      --times 1000 3162
      --J 1.0
      --Jpm 0 0.05
      --jx-unscaled 0.03
      --jy-unscaled 0 0.03
      --Jz 0
      --Jzx 0 0.02
      --jcpm-unscaled 0
      --hz 0.1
      --hz0-modes matched
    )
    ;;
  8)
    RUN_NAME="all_to_all_sz_conserving_N15_N16"
    ARGS=(
      --N 15 16
      --connectivity all_to_all
      --times 1000 3162
      --J 1.0
      --Jpm 0.05 0.1
      --jx-unscaled 0
      --jy-unscaled 0
      --Jz 0.03
      --Jzx 0
      --jcpm-unscaled 0.02 0.05
      --hz 0.1
      --hz0-modes matched
    )
    ;;
  9)
    RUN_NAME="ring_detuned_controls_N15_N16"
    ARGS=(
      --N 15 16
      --connectivity ring
      --times 1000 3162
      --J 1.0
      --Jpm 0 0.05
      --jx-unscaled 0.04 0.05
      --jy-unscaled 0
      --hz 0.08 0.1
      --hz0-modes zero half minus
    )
    ;;
  *)
    echo "Unknown anisotropic/larger-N TASK_ID: $TASK_ID" >&2
    echo "Valid task ids are 1 through 9." >&2
    exit 2
    ;;
esac

OUT_DIR="$RUN_ROOT/$RUN_NAME"
RUN_LOG="$LOG_ROOT/${RUN_NAME}.${PBS_JOBID:-local}.${TASK_ID}.log"
OUT_LOG="$OUT_DIR/run.log"

mkdir -p "$OUT_DIR"

timestamp_stream() {
  awk 'BEGIN { ts_re="^\[[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T" } $0 ~ ts_re { print; fflush(); next } { print strftime("[%Y-%m-%dT%H:%M:%S%z]"), $0; fflush(); }'
}

exec > >(timestamp_stream | tee "$RUN_LOG") 2>&1

ensure_output_log_on_exit() {
  status=$?
  if [ ! -s "$OUT_LOG" ] && [ -s "$RUN_LOG" ]; then
    cp "$RUN_LOG" "$OUT_LOG"
  fi
  exit "$status"
}
trap ensure_output_log_on_exit EXIT

echo "Host: $(hostname)"
echo "Task: $TASK_ID"
echo "Run: $RUN_NAME"
echo "Output: $OUT_DIR"
echo "Scheduler-side log: $RUN_LOG"
echo "Per-output run.log: $OUT_LOG"
echo "Workdir: $(pwd)"
echo "Python command: $PYTHON_BIN"
echo "Python version: $("$PYTHON_BIN" --version 2>&1)"
echo "BORN_WORKERS: $BORN_WORKERS"
echo "OMP/MKL/OPENBLAS/NUMEXPR threads: $OMP_NUM_THREADS/$MKL_NUM_THREADS/$OPENBLAS_NUM_THREADS/$NUMEXPR_NUM_THREADS"

if [ "${BACKUP_EXISTING_OUTPUTS:-0}" = "1" ]; then
  BACKUP_DIR="$OUT_DIR/_rerun_backup_$(date +%Y%m%d_%H%M%S)"
  backed_up=0
  for path in "$OUT_LOG" "$OUT_DIR/results.csv" "$OUT_DIR/results.json" "$OUT_DIR/top_candidates.md"; do
    if [ -e "$path" ]; then
      mkdir -p "$BACKUP_DIR"
      mv "$path" "$BACKUP_DIR/"
      backed_up=1
    fi
  done
  if [ "$backed_up" = "1" ]; then
    echo "Backed up existing output files to: $BACKUP_DIR"
  else
    echo "BACKUP_EXISTING_OUTPUTS=1 set, but no existing output files were found."
  fi
fi

"$PYTHON_BIN" scripts/born_hamiltonian_search.py "${ARGS[@]}" "${COMMON_ARGS[@]}" --out-dir "$OUT_DIR" --log-file "$OUT_LOG"
