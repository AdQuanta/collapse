#!/bin/bash
# Exact top/bottom ring configurations from the N=17 spacing study.
# Two configurations per task; each configuration is checkpointed separately.
#PBS -N ring_extremes_N17
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=16:mem=256gb
#PBS -l walltime=120:00:00
#PBS -J 0-19
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/scripts/run_zeus_ranked_ring_extremes_N17.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../scripts/run_zeus_ranked_ring_extremes_N17.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate the ranked-ring N=17 runner. Submit from the repository root or hpc/." >&2
  exit 2
fi
cd "$REPO_ROOT"

if [[ -n "${ZEUS_ENV_SETUP:-}" ]]; then source "$ZEUS_ENV_SETUP"; fi
if [[ -n "${VIRTUAL_ENV_PATH:-}" ]]; then source "$VIRTUAL_ENV_PATH/bin/activate"; fi

: "${RUN_ROOT:?submit through hpc/submit_zeus_ranked_ring_extremes_N17.sh}"
ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:?PBS array index unavailable}}"
CONFIG="${CONFIG:-configs/zeus_ranked_ring_extremes_N17.json}"
PYTHON_BIN="${PYTHON_BIN:-python3.11}"
REUSE_EXISTING_N17="${REUSE_EXISTING_N17:-1}"

mkdir -p "$RUN_ROOT/logs" "$RUN_ROOT/.mplconfig/task_$ARRAY_INDEX"
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig/task_$ARRAY_INDEX"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-16}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-16}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-16}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-16}"

if [[ "$REUSE_EXISTING_N17" == "1" ]]; then
  REUSE_FLAG="--reuse-existing-n17"
else
  REUSE_FLAG="--no-reuse-existing-n17"
fi

LOG="$RUN_ROOT/logs/task_${ARRAY_INDEX}.log"
echo "[$(date --iso-8601=seconds)] task=$ARRAY_INDEX cases_per_task=2 total_cases=40 N=17 reuse_existing_N17=$REUSE_EXISTING_N17 checkpoint=each_configuration" | tee -a "$LOG"
"$PYTHON_BIN" scripts/run_zeus_ranked_ring_extremes_N17.py \
  --array-index "$ARRAY_INDEX" \
  --config "$CONFIG" \
  --output-root "$RUN_ROOT" \
  --resume \
  "$REUSE_FLAG" 2>&1 | tee -a "$LOG"

