#!/bin/bash
# Full N=13 detector-spectrum and V_ab atlas for all relative-scale regimes.
#PBS -N det_spec_N13
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/examples/run_detector_spectra_zeus_N13.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../examples/run_detector_spectra_zeus_N13.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate examples/run_detector_spectra_zeus_N13.py." >&2
  echo "Submit from the repository root or hpc/ after synchronizing the new files." >&2
  exit 2
fi
cd "$REPO_ROOT"

PYTHON_BIN="${PYTHON_BIN:-python3.11}"
CONFIG_PATH="${CONFIG_PATH:-configs/zeus_detector_spectra_N13.json}"
RUN_ROOT="${RUN_ROOT:-work/zeus_detector_spectra_N13}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_detector_spectra_N13}"
NUMERIC_THREADS="${NUMERIC_THREADS:-8}"

mkdir -p "$RUN_ROOT" "$LOG_ROOT" "$RUN_ROOT/.mplconfig"
export MPLBACKEND=Agg
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="$NUMERIC_THREADS"
export MKL_NUM_THREADS="$NUMERIC_THREADS"
export OPENBLAS_NUM_THREADS="$NUMERIC_THREADS"
export BLIS_NUM_THREADS="$NUMERIC_THREADS"
export NUMEXPR_NUM_THREADS="$NUMERIC_THREADS"
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"

JOB_TAG="${PBS_JOBID:-manual}"
TASK_LOG="$LOG_ROOT/N13_${JOB_TAG}.log"

timestamp_stream() {
  awk '{ print strftime("[%Y-%m-%dT%H:%M:%S%z]"), "worker=1", $0; fflush(); }'
}
exec > >(timestamp_stream | tee "$TASK_LOG") 2>&1

echo "event=START N=13 host=$(hostname)"
echo "REPO_ROOT=$REPO_ROOT"
echo "CONFIG_PATH=$CONFIG_PATH"
echo "RUN_ROOT=$RUN_ROOT"
echo "TASK_LOG=$TASK_LOG"
echo "PYTHON_BIN=$PYTHON_BIN"
echo "NUMERIC_THREADS=$NUMERIC_THREADS"
echo "EXECUTION_POLICY=one_dense_regime_at_a_time"
echo "CHECKPOINT_POLICY=save_arrays_metadata_and_block_table_after_each_regime"

"$PYTHON_BIN" -c \
  'import sys, numpy, matplotlib; assert sys.version_info[:2] == (3, 11), sys.version; from collapse.detector_resonance import DenseRingDetectorBuilder; print(sys.version); print("numpy", numpy.__version__); print("matplotlib", matplotlib.__version__)'

ARGS=(
  --config "$CONFIG_PATH"
  --run-root "$RUN_ROOT"
  --numeric-threads "$NUMERIC_THREADS"
)
if [[ "${DRY_RUN:-0}" == "1" ]]; then
  ARGS+=(--dry-run)
fi

trap 'echo "event=INTERRUPTED N=13"; exit 143' TERM INT
"$PYTHON_BIN" examples/run_detector_spectra_zeus_N13.py "${ARGS[@]}"

echo "event=FINISH N=13"
echo "Report: $RUN_ROOT/REPORT.md"
echo "Manifest: $RUN_ROOT/run_manifest.json"
echo "Per-regime outputs: $RUN_ROOT/regimes/<case_id>/"
echo "Log: $TASK_LOG"
