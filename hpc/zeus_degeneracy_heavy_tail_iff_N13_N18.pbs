#!/bin/bash
# Unified exact-degeneracy simulation and aggregation workflow.
# One array task owns one N; process workers own different Hamiltonian cases.
#PBS -N degen_ht_iff
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=120:00:00
#PBS -J 13-18
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/scripts/run_degeneracy_heavy_tail_campaign.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../scripts/run_degeneracy_heavy_tail_campaign.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate scripts/run_degeneracy_heavy_tail_campaign.py from $SUBMIT_DIR." >&2
  echo "Submit from the repository root or hpc/ after synchronizing the new files." >&2
  exit 2
fi
cd "$REPO_ROOT"

if [[ -n "${ZEUS_ENV_SETUP:-}" ]]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi
if [[ -n "${PYTHON_MODULES:-}" ]]; then
  if ! command -v module >/dev/null 2>&1; then
    echo "PYTHON_MODULES is set, but the module command is unavailable." >&2
    exit 2
  fi
  for mod in $PYTHON_MODULES; do module load "$mod"; done
fi
PYTHON_BIN="${PYTHON_BIN:-python3.11}"
CONFIG_PATH="${CONFIG_PATH:-configs/zeus_degeneracy_heavy_tail_iff_N13_N18.json}"
RUN_ROOT="${RUN_ROOT:-work/zeus_degeneracy_heavy_tail_iff_N13_N18}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_degeneracy_heavy_tail_iff_N13_N18}"
TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TASK_ID:-}}}"
if [[ -z "$TASK_ID" || ! "$TASK_ID" =~ ^(13|14|15|16|17|18)$ ]]; then
  echo "PBS array index must select N=13..18; got '$TASK_ID'." >&2
  exit 2
fi
if [[ ! -f "$CONFIG_PATH" ]]; then
  echo "Missing configuration: $REPO_ROOT/$CONFIG_PATH" >&2
  exit 2
fi

case "$TASK_ID" in
  13) DEFAULT_WORKERS=4; DEFAULT_NUMERIC_THREADS=2 ;;
  14|15) DEFAULT_WORKERS=2; DEFAULT_NUMERIC_THREADS=4 ;;
  16|17|18) DEFAULT_WORKERS=1; DEFAULT_NUMERIC_THREADS=8 ;;
esac
CONFIG_WORKERS="${CONFIG_WORKERS:-$DEFAULT_WORKERS}"
NUMERIC_THREADS="${NUMERIC_THREADS:-$DEFAULT_NUMERIC_THREADS}"

mkdir -p "$RUN_ROOT" "$LOG_ROOT" "$RUN_ROOT/.mplconfig"
export MPLBACKEND=Agg
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS="$NUMERIC_THREADS"
export MKL_NUM_THREADS="$NUMERIC_THREADS"
export OPENBLAS_NUM_THREADS="$NUMERIC_THREADS"
export BLIS_NUM_THREADS="$NUMERIC_THREADS"
export NUMEXPR_NUM_THREADS="$NUMERIC_THREADS"

JOB_TAG="${PBS_JOBID:-manual}"
TASK_LOG="$LOG_ROOT/N${TASK_ID}_${JOB_TAG}.log"
exec >"$TASK_LOG" 2>&1

echo "[$(date --iso-8601=seconds)] event=START task=N$TASK_ID"
echo "REPO_ROOT=$REPO_ROOT"
echo "CONFIG_PATH=$CONFIG_PATH"
echo "RUN_ROOT=$RUN_ROOT"
echo "TASK_LOG=$TASK_LOG"
echo "PYTHON_BIN=$PYTHON_BIN"
echo "CONFIG_WORKERS=$CONFIG_WORKERS"
echo "NUMERIC_THREADS=$NUMERIC_THREADS"
echo "COLLECTIVE_JX=0.01"
echo "EDGE_COUPLING_FORMULA=0.01/sqrt(N)"
echo "PERTURBATIVE_RULE=every_nonzero_abs(hz,J,Jpm)>=10*Jx"
echo "DIAGNOSTICS=P(theta)_and_P(pi-theta)_histograms,R(theta)_vs_Born,Bloch_sphere"
echo "CHECKPOINT_POLICY=save_each_case_then_per_N_plots_then_locked_cross_N_summary"

"$PYTHON_BIN" -c 'import sys; assert sys.version_info[:2] == (3, 11), sys.version; import importlib.metadata as m; expected={"quspin":"1.0.0","quspin-extensions":"0.1.6"}; actual={k:m.version(k) for k in expected}; assert actual == expected, actual; print(sys.version); print(actual)'

if [[ "${SMOKE:-0}" == "1" && "$TASK_ID" != "13" ]]; then
  echo "SMOKE=1: only array index 13 runs; safely skipping N=$TASK_ID."
  exit 0
fi

RUN_N="$TASK_ID"
GLOBAL_ARGS=(--config "$CONFIG_PATH" --run-root "$RUN_ROOT")
if [[ "${SMOKE:-0}" == "1" ]]; then
  GLOBAL_ARGS+=(--smoke)
  RUN_N=4
fi
TASK_ARGS=(simulate-N --N "$RUN_N" --workers "$CONFIG_WORKERS")
if [[ "${DRY_RUN:-0}" == "1" ]]; then TASK_ARGS+=(--dry-run); fi
if [[ "${FORCE:-0}" == "1" ]]; then TASK_ARGS+=(--force); fi

trap 'echo "[$(date --iso-8601=seconds)] event=INTERRUPTED task=N'"$TASK_ID"'"; exit 143' TERM INT
"$PYTHON_BIN" scripts/run_degeneracy_heavy_tail_campaign.py \
  "${GLOBAL_ARGS[@]}" "${TASK_ARGS[@]}"

echo "[$(date --iso-8601=seconds)] event=FINISH task=N$RUN_N"
echo "Outputs: $RUN_ROOT"
echo "Per-N checkpoint: $RUN_ROOT/status/N$(printf '%02d' "$RUN_N")/DONE.json"
echo "Latest unified summary: $RUN_ROOT/aggregates/all_N/summary.json"
echo "Log: $TASK_LOG"
