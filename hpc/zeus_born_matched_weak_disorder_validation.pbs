#!/bin/bash
# PBS array for focused matched-ring weak-disorder validation.
#
# Goal: test whether the local N=10 weak-disordered matched-ring signal
# survives N-scaling, seed changes, and the decisive local controls.
#
#PBS -N born_wd_ring
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -J 1-9
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

PBS_O_WORKDIR="${PBS_O_WORKDIR:-$HOME/research/collapse}"
cd "$PBS_O_WORKDIR"

if [ -n "${ZEUS_ENV_SETUP:-}" ]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi

if [ -n "${PYTHON_MODULES:-}" ]; then
  if ! command -v module >/dev/null 2>&1; then
    echo "PYTHON_MODULES was set, but the module command is unavailable." >&2
    exit 2
  fi
  for mod in $PYTHON_MODULES; do
    module load "$mod"
  done
fi

if [ -n "${VIRTUAL_ENV_PATH:-}" ]; then
  # shellcheck source=/dev/null
  source "$VIRTUAL_ENV_PATH/bin/activate"
fi

export PYTHONUNBUFFERED=1
if [ -n "${PBS_NODEFILE:-}" ] && [ -r "$PBS_NODEFILE" ]; then
  PBS_NP_DEFAULT="$(wc -l < "$PBS_NODEFILE")"
else
  PBS_NP_DEFAULT="${PBS_NP:-8}"
fi
export BORN_WORKERS="${BORN_WORKERS:-$PBS_NP_DEFAULT}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-1}"
export OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-1}"
export NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-1}"

PYTHON_BIN="${PYTHON_BIN:-python3.11}"
TASK_ID="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${TASK_ID:-1}}}"
RUN_ROOT="${RUN_ROOT:-figures/zeus_born_matched_weak_disorder_validation}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_born_matched_weak_disorder_validation}"
PLOT_TOP="${PLOT_TOP:-12}"
PLOT_MAX_BLOCH_POINTS="${PLOT_MAX_BLOCH_POINTS:-6000}"

mkdir -p "$RUN_ROOT" "$LOG_ROOT"

COMMON_ARGS=(
  --bins 100
  --tail-fraction 0.10
  --log-bins 50
  --backend quspin
  --top 60
  --workers "$BORN_WORKERS"
  --plot-top "$PLOT_TOP"
  --plot-max-bloch-points "$PLOT_MAX_BLOCH_POINTS"
)

timestamp_stream() {
  awk 'BEGIN { ts_re="^\[[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T" } $0 ~ ts_re { print; fflush(); next } { print strftime("[%Y-%m-%dT%H:%M:%S%z]"), $0; fflush(); }'
}

case "$TASK_ID" in
  1) RUN_NAME="uniform_matched_ring_all_N12_N13_seed44" ;;
  2) RUN_NAME="uniform_matched_ring_all_N14_seed44" ;;
  3) RUN_NAME="uniform_matched_ring_all_N15_N16_seed44" ;;
  4) RUN_NAME="uniform_matched_ring_seed_sweep_N10_N12" ;;
  5) RUN_NAME="gaussian_matched_ring_all_N12_N14_seed44" ;;
  6) RUN_NAME="clean_matched_ring_all_N12_N14_seed44" ;;
  7) RUN_NAME="uniform_ring_central_coupling_controls_N12_N14_seed44" ;;
  8) RUN_NAME="uniform_chain_controls_N12_N14_seed44" ;;
  9) RUN_NAME="uniform_anisotropic_ring_all_N12_N14_seed44" ;;
  *)
    echo "Unknown matched weak-disorder TASK_ID: $TASK_ID" >&2
    echo "Valid task ids are 1 through 9." >&2
    exit 2
    ;;
esac
RUN_LOG="$LOG_ROOT/${RUN_NAME}.${PBS_JOBID:-local}.${TASK_ID}.log"
TASK_OUT_DIR="$RUN_ROOT/$RUN_NAME"
TASK_OUT_LOG="$TASK_OUT_DIR/run.log"

mkdir -p "$TASK_OUT_DIR"

exec > >(timestamp_stream | tee "$RUN_LOG") 2>&1

ensure_task_output_log_on_exit() {
  status=$?
  if [ ! -s "$TASK_OUT_LOG" ] && [ -s "$RUN_LOG" ]; then
    cp "$RUN_LOG" "$TASK_OUT_LOG"
  fi
  exit "$status"
}
trap ensure_task_output_log_on_exit EXIT

echo "Host: $(hostname)"
echo "Task: $TASK_ID"
echo "Run: $RUN_NAME"
echo "Run root: $RUN_ROOT"
echo "Scheduler-side log: $RUN_LOG"
echo "Task output run.log: $TASK_OUT_LOG"
echo "Workdir: $(pwd)"
echo "Python command: $PYTHON_BIN"
echo "Python version: $("$PYTHON_BIN" --version 2>&1)"
echo "BORN_WORKERS: $BORN_WORKERS"
echo "OMP/MKL/OPENBLAS/NUMEXPR threads: $OMP_NUM_THREADS/$MKL_NUM_THREADS/$OPENBLAS_NUM_THREADS/$NUMEXPR_NUM_THREADS"

run_search() {
  local run_name="$1"
  shift
  local out_dir="$RUN_ROOT/$run_name"
  mkdir -p "$out_dir"

  echo
  echo "=== Search: $run_name ==="
  echo "Output: $out_dir"
  echo "Output run.log: $out_dir/run.log"
  "$PYTHON_BIN" examples/born_hamiltonian_search.py \
    "$@" \
    "${COMMON_ARGS[@]}" \
    --out-dir "$out_dir" \
    --log-file "$out_dir/run.log"
}

case "$TASK_ID" in
  1)
    RUN_NAME="uniform_matched_ring_all_N12_N13_seed44"
    run_search "$RUN_NAME" \
      --model single_pixel \
      --N 12 13 \
      --connectivity ring \
      --central-coupling all \
      --hz0-modes matched \
      --disorder uniform \
      --disorder-strength-J 0.005 0.02 \
      --times 316 1000 3162 10000 \
      --J 1.0 \
      --Jpm 0 \
      --jx-unscaled 0.03 0.05 \
      --jy-unscaled 0 \
      --hz 0.08 0.1 \
      --seed 44
    ;;
  2)
    RUN_NAME="uniform_matched_ring_all_N14_seed44"
    run_search "$RUN_NAME" \
      --model single_pixel \
      --N 14 \
      --connectivity ring \
      --central-coupling all \
      --hz0-modes matched \
      --disorder uniform \
      --disorder-strength-J 0.005 0.02 \
      --times 316 1000 3162 10000 \
      --J 1.0 \
      --Jpm 0 \
      --jx-unscaled 0.03 0.05 \
      --jy-unscaled 0 \
      --hz 0.08 0.1 \
      --seed 44
    ;;
  3)
    RUN_NAME="uniform_matched_ring_all_N15_N16_seed44"
    run_search "$RUN_NAME" \
      --model single_pixel \
      --N 15 16 \
      --connectivity ring \
      --central-coupling all \
      --hz0-modes matched \
      --disorder uniform \
      --disorder-strength-J 0.005 0.02 \
      --times 316 1000 3162 10000 \
      --J 1.0 \
      --Jpm 0 \
      --jx-unscaled 0.05 \
      --jy-unscaled 0 \
      --hz 0.08 0.1 \
      --seed 44
    ;;
  4)
    RUN_NAME="uniform_matched_ring_seed_sweep_N10_N12"
    for seed in 11 44 73 101; do
      run_search "uniform_matched_ring_seed_${seed}_N10_N12" \
        --model single_pixel \
        --N 10 12 \
        --connectivity ring \
        --central-coupling all \
        --hz0-modes matched \
        --disorder uniform \
        --disorder-strength-J 0.005 0.02 \
        --times 316 1000 3162 \
        --J 1.0 \
        --Jpm 0 \
        --jx-unscaled 0.05 \
        --jy-unscaled 0 \
        --hz 0.08 0.1 \
        --seed "$seed"
    done
    ;;
  5)
    RUN_NAME="gaussian_matched_ring_all_N12_N14_seed44"
    run_search "$RUN_NAME" \
      --model single_pixel \
      --N 12 13 14 \
      --connectivity ring \
      --central-coupling all \
      --hz0-modes matched \
      --disorder gaussian \
      --disorder-strength-J 0.005 0.02 \
      --times 316 1000 3162 10000 \
      --J 1.0 \
      --Jpm 0 \
      --jx-unscaled 0.03 0.05 \
      --jy-unscaled 0 \
      --hz 0.08 0.1 \
      --seed 44
    ;;
  6)
    RUN_NAME="clean_matched_ring_all_N12_N14_seed44"
    run_search "$RUN_NAME" \
      --model single_pixel \
      --N 12 13 14 \
      --connectivity ring \
      --central-coupling all \
      --hz0-modes matched \
      --disorder none \
      --times 316 1000 3162 10000 \
      --J 1.0 \
      --Jpm 0 \
      --jx-unscaled 0.03 0.05 \
      --jy-unscaled 0 \
      --hz 0.08 0.1 \
      --seed 44
    ;;
  7)
    RUN_NAME="uniform_ring_central_coupling_controls_N12_N14_seed44"
    run_search "$RUN_NAME" \
      --model single_pixel \
      --N 12 13 14 \
      --connectivity ring \
      --central-coupling first ends \
      --hz0-modes matched \
      --disorder uniform \
      --disorder-strength-J 0.005 0.02 \
      --times 316 1000 3162 \
      --J 1.0 \
      --Jpm 0 \
      --jx-unscaled 0.05 \
      --jy-unscaled 0 \
      --hz 0.08 0.1 \
      --seed 44
    ;;
  8)
    RUN_NAME="uniform_chain_controls_N12_N14_seed44"
    run_search "$RUN_NAME" \
      --model single_pixel \
      --N 12 13 14 \
      --connectivity chain \
      --central-coupling auto ends \
      --hz0-modes matched \
      --disorder uniform \
      --disorder-strength-J 0.005 0.02 \
      --times 316 1000 3162 \
      --J 1.0 \
      --Jpm 0 \
      --jx-unscaled 0.05 \
      --jy-unscaled 0 \
      --hz 0.08 0.1 \
      --seed 44
    ;;
  9)
    RUN_NAME="uniform_anisotropic_ring_all_N12_N14_seed44"
    run_search "$RUN_NAME" \
      --model single_pixel \
      --N 12 13 14 \
      --connectivity ring \
      --central-coupling all \
      --hz0-modes matched \
      --disorder uniform \
      --disorder-strength-J 0.005 \
      --times 316 1000 3162 \
      --J 1.0 \
      --Jpm 0 \
      --Jxx 0.02 0.05 \
      --Jyy 0.01 0.04 \
      --Jz 0 0.02 \
      --jx-unscaled 0.05 \
      --jy-unscaled 0 \
      --hz 0.08 0.1 \
      --seed 44
    ;;
  *)
    echo "Unknown matched weak-disorder TASK_ID: $TASK_ID" >&2
    echo "Valid task ids are 1 through 9." >&2
    exit 2
    ;;
esac

echo
echo "Completed task $TASK_ID ($RUN_NAME)."
