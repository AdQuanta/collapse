#!/bin/bash
# Cheap cross-N synthesis after all six simulation-array tasks finish.
#PBS -N degen_ht_syn
#PBS -q zeus_new_q
#PBS -l select=1:ncpus=8:mem=128gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -m abe
#PBS -M matanhaller@campus.technion.ac.il

set -euo pipefail

SUBMIT_DIR="${PBS_O_WORKDIR:?PBS_O_WORKDIR is unavailable}"
if [[ -f "$SUBMIT_DIR/examples/run_degeneracy_heavy_tail_campaign.py" ]]; then
  REPO_ROOT="$SUBMIT_DIR"
elif [[ -f "$SUBMIT_DIR/../examples/run_degeneracy_heavy_tail_campaign.py" ]]; then
  REPO_ROOT="$(cd "$SUBMIT_DIR/.." && pwd)"
else
  echo "Cannot locate examples/run_degeneracy_heavy_tail_campaign.py from $SUBMIT_DIR." >&2
  exit 2
fi
cd "$REPO_ROOT"

if [[ -n "${ZEUS_ENV_SETUP:-}" ]]; then
  # shellcheck source=/dev/null
  source "$ZEUS_ENV_SETUP"
fi
PYTHON_BIN="${PYTHON_BIN:-python3.11}"
CONFIG_PATH="${CONFIG_PATH:-configs/zeus_degeneracy_heavy_tail_iff_N13_N18.json}"
RUN_ROOT="${RUN_ROOT:-work/zeus_degeneracy_heavy_tail_iff_N13_N18}"
LOG_ROOT="${LOG_ROOT:-logs/zeus_degeneracy_heavy_tail_iff_N13_N18}"
JOB_TAG="${PBS_JOBID:-manual}"

mkdir -p "$RUN_ROOT" "$LOG_ROOT" "$RUN_ROOT/.mplconfig"
export MPLBACKEND=Agg
export MPLCONFIGDIR="$RUN_ROOT/.mplconfig"
export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

TASK_LOG="$LOG_ROOT/aggregate_${JOB_TAG}.log"
exec >"$TASK_LOG" 2>&1

echo "[$(date --iso-8601=seconds)] event=START aggregate-all"
"$PYTHON_BIN" examples/run_degeneracy_heavy_tail_campaign.py \
  --config "$CONFIG_PATH" \
  --run-root "$RUN_ROOT" \
  aggregate-all
echo "[$(date --iso-8601=seconds)] event=FINISH aggregate-all"
echo "Summary: $RUN_ROOT/aggregates/all_N/summary.json"
echo "Log: $TASK_LOG"
